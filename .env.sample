# ── Required ──────────────────────────────────────────────────
DATABASE_URL=postgresql://vela:vela@localhost:5432/vela
JWT_SECRET=replace-me-with-a-strong-jwt-secret
CREDENTIALS_ENCRYPTION_KEY=replace-me-with-a-strong-secret
FRONTEND_AUTH_CALLBACK_URL=http://localhost:3001/auth/callback

# ── Server ────────────────────────────────────────────────────
# PORT=3000
# CORS_ORIGINS=http://localhost:3000
# INGEST_MAX_BODY_BYTES=1048576

# ── Database ──────────────────────────────────────────────────
# DATABASE_SYNCHRONIZE=false      # Never true in production
# DB_SSL=false
# DB_LOGGING=false

# ── RabbitMQ (optional — falls back to in-memory if unset) ───
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# RABBITMQ_DELIVERY_MAX_RETRIES=3
# RABBITMQ_DELIVERY_RETRY_DELAY_MS=30000

# ── Email via Resend (optional — required for email delivery) ─
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=alerts@your-domain.com

# ── Google OAuth (optional) ───────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# ── GitHub OAuth (optional) ───────────────────────────────────
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:3000/v1/auth/github/callback

# ── Feature flags (development/testing) ───────────────────────
# SKIP_DATABASE=false
# SKIP_RABBITMQ=false
